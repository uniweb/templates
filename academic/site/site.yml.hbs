name: Research Profile
description: A researcher’s site with a profile, research projects, a full publication list and the team.
tags: [academic, research, personal]
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Build options
build:
  prerender: true

# Search (kit's search client — the foundation installs nothing for it)
search:
  enabled: true
  include:
    pages: true
    sections: true
    headings: true

name: Blog
description: A blog with article cards on its home page and a full page for every post.
tags: [blog, personal]
defaultLanguage: en

# Foundation to use for this site
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Enable search functionality
search: true

# Queries — each selects a set of records. `articles` reads the @std/article
# records: markdown files in entities/std/article/, published by records.yml.
# They compile to JSON at build time and — when synced to a backend — become
# @std/article entities (the query's `schema:`).
queries:
  articles:
    schema: '@std/article'
    sort: date desc

# Build options
build:
  prerender: true

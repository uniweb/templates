name: {{projectName}}
description: Notes on building for the web.
defaultLanguage: en

# Foundation to use for this site
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Enable search functionality
search: true

# Content collections
# Markdown files in collections/ are processed into JSON at build time, and —
# when synced to a backend — into @std/article entities (the `schema:` binding).
collections:
  articles:
    path: collections/articles
    schema: '@std/article'
    route: /blog
    sort: date desc

# Build options
build:
  prerender: true

name: Multilingual Nonprofit
description: A conservation nonprofit’s site in English, Spanish and French, with its mission, research, news and a contact page.
tags: [nonprofit, community]
defaultLanguage: en
languages: [en, es, fr]

# Foundation to use for this site
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Where the translations live, and each language's URLs
i18n:
  localesDir: locales
  routeTranslations:
    es:
      /about: /acerca-de
      /research: /investigacion
      /contact: /contacto
      /blog: /noticias
    fr:
      /about: /a-propos
      /research: /recherche
      /contact: /contact
      /blog: /actualites

# Services — search on, and `records`: your host delivers the site's records to
# its published pages. A static build reads them from the files it writes instead.
services:
  search: true
  records: true

# Queries — each selects a set of records. `articles` reads the @std/article
# records: markdown files in records/std/article/ — every file there is one.
# They compile to JSON at build time and — when pushed to a backend — become
# @std/article entities (the query's `schema:`).
queries:
  articles:
    schema: '@std/article'
    sort: date desc

  # `team` reads records/team/, one JSON file per member, named by its file —
  # records like the markdown articles above, so they get i18n extraction too.
  # Their type is the Team section's `data: { team: '@/member' }`.
  team:

# Build options
build:
  prerender: true

name: {{projectName}}
description: Global Panda Conservation Research
defaultLanguage: en

# Foundation to use for this site
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Internationalization configuration
# This template includes English (default), Spanish, and French
i18n:
  locales: [es, fr]
  localesDir: locales
  routeTranslations:
    es:
      /about: /acerca-de
      /research: /investigacion
      /contact: /contacto
      /blog: /noticias
    fr:
      /about: /a-propos
      /research: /recherche
      /contact: /contact
      /blog: /actualites

# Enable search functionality
search: true

# Queries — each selects a set of records. `articles` reads the @std/article
# records: markdown files in entities/std/article/, published by records.yml.
# They compile to JSON at build time and — when synced to a backend — become
# @std/article entities (the query's `schema:`).
queries:
  articles:
    schema: '@std/article'
    sort: date desc

  # `team` reads entities/team/. A JSON file holding a top-level array is one
  # record per entry — records like the markdown articles above, so they get
  # i18n extraction too.
  team:

# Build options
build:
  prerender: true

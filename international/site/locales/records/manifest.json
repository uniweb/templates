    "5c1ccde1": {
      "source": "The three new corridors span a combined 45 kilometers, connecting five previously isolated forest patches. Camera trap monitoring has already documented pandas using all three corridors.",
      "field": "article_body.content.paragraph.3",
      "contexts": [
        {
          "record": "std/article/habitat-protection"
        }
      ]
    },

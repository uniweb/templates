name: Field Research
description: A conservation research site with live data, such as field notes, weather, wildlife sightings, research papers and videos.
tags: [research, nonprofit, blog]

# Foundation to use for this site
foundation: foundation

# Homepage
index: home

# A JSON file holding a top-level array is one record per entry. Data exported
# from another tool belongs here, not in public/data/ — that directory is the
# build's output.
queries:
  # External queries — public, keyless APIs, declared here and named by the pages
  # that show them. A query with `url:` is fetched from that address in the visitor's
  # browser; `transform:` is the dot-path to its records in the response.
  weather:
    url: https://api.open-meteo.com/v1/forecast?latitude=31.0&longitude=103.2&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&wind_speed_unit=ms
    transform: current
  posts:
    url: https://jsonplaceholder.typicode.com/posts?_limit=12
    # One post, for the blog's [id] page — `{id}` is the page's URL segment.
    record:
      url: https://jsonplaceholder.typicode.com/posts/{id}
  sightings:
    url: https://api.inaturalist.org/v1/observations?taxon_id=41659&order_by=created_at&order=desc&per_page=3&photos=true&quality_grade=research
    transform: results
  donors:
    url: https://randomuser.me/api/?results=6
    transform: results
  occurrences:
    url: https://api.gbif.org/v1/occurrence/search?taxonKey=2433399&limit=6
    transform: results
  papers:
    url: https://api.crossref.org/works?query=giant%20panda%20conservation&rows=5&sort=published&order=desc
    transform: message.items

  videos:
  # Markdown entries placed in folders by records.yml. Rendered by
  # pages/logbook — a list, and the `[...path]` page, with a URL for every entry.
  logbook:
    sort: date desc
    # The page that renders one entry is pages/logbook/[...path]/, so each record's
    # own URL — `$route`, filled by the framework — is its placement plus its slug.

# Build options
build:
  prerender: true

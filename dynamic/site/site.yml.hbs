name: {{projectName}}
description: Conservation powered by real-time data

# Foundation to use for this site
foundation: foundation

# Homepage
index: home

# A JSON file holding a top-level array is one record per entry. Data exported
# from another tool belongs here, not in public/data/ — that directory is the
# build's output.
queries:
  videos:
  # Markdown entries placed in folders by records.yml. Rendered by
  # pages/logbook — a list, and one `[...path]` page for every entry.
  logbook:
    sort: date desc
    # The page that renders one entry is pages/logbook/[...path]/, so a record's
    # own URL (`route` on each record) is its placement plus its slug.
    route: /logbook/[...path]

# Build options
build:
  prerender: true

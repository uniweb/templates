name: Documentation
description: Technical documentation with sidebar navigation, versioned pages and highlighted code examples.
tags: [documentation, technology]

# Homepage - specifies which page folder becomes the root route (/)
index: docs

# Theme configuration
theme:
  primary: '#2563eb'

# Search configuration
search:
  enabled: true
  include:
    pages: true
    sections: true
    headings: true

# Build options
build:
  prerender: true

name: Paste a Design
description: A one-page site built from an existing React design, pasted in as it is.
tags: [landing-page]
defaultLanguage: en
foundation: foundation
index: home

# ── Rendering mode ───────────────────────────────────────────────────────────
# SPA-first: the site renders entirely in the browser. This lets you paste ANY
# React design and see it live without a server-side render pass — many
# AI-generated designs read `window`/`document` while rendering, which would
# crash prerendering. Once your design is SSR-clean, set `prerender: true` to
# emit static HTML for better SEO and first paint.
build:
  prerender: false

name: Artisan Store
description: An online shop for handmade solar lighting, with product pages, a buy button and a journal.
tags: [store, arts]
defaultLanguage: en

# Foundation to use for this site
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Queries — each selects a set of records: `products` reads records/products/,
# `articles` reads records/articles/ (every file in those folders is a record)
queries:
  products:
    sort: order asc
  articles:
    sort: date desc

# Build options
build:
  prerender: true

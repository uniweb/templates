name: {{projectName}}
defaultLanguage: en

# Foundation to use for this site
foundation: foundation

# Homepage - specifies which page folder becomes the root route (/)
index: home

# Queries — each selects a set of records: `products` reads entities/products/,
# `articles` reads entities/articles/ (both published by records.yml)
queries:
  products:
    sort: order asc
  articles:
    sort: date desc

# Build options
build:
  prerender: true

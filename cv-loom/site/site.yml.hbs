# Site Configuration
# Full reference: uniweb docs site  |  Schema: schemas/site.schema.json

name: Academic CV
description: An academic CV, shown as a web page and downloadable as a Word document.
tags: [resume, academic]
foundation: foundation

index: cv

# Services — `records` asks your host to deliver the site's records to its
# published pages. A static build reads them from the files it writes instead.
services:
  records: true

queries:
  profile:

build:
  prerender: true

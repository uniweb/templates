# Site Configuration
# Full reference: uniweb docs site  |  Schema: schemas/site.schema.json

name: {{projectName}}
foundation: foundation

index: report

queries:
  members:
    # Queryable surface — declares which fields a foundation can offer
    # for filtering UI. The FilterPanel component reads this metadata
    # via the useQueryable hook and renders one control per field. A
    # composed predicate narrows the delivered members exactly as a
    # saved view's does.
    queryable:
      department:
        type: enum
        label: Department
        options: [biology, geology]
      rank:
        type: enum
        label: Rank
        options: [associate, professor]
      tenured:
        type: boolean
        label: Tenured
      start_year:
        type: range
        label: Start year
        min: 1820
        max: 1880
  queries:

# Where the predicate runs. The report page's query delivers every member to
# its sections, and a selection — a saved view or a panel-composed filter — is
# a `where:` the foundation applies to those members in the browser, with no
# request per selection. Where the records come from is the query's business:
# the site's own files, a host that serves records live, or a backend of your
# own reached through a foundation TRANSPORT selected here
# (`fetcher.transports`) — see docs: development/data-sources.md.

build:
  prerender: true

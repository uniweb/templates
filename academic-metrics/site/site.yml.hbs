# Site Configuration
# Full reference: uniweb docs site  |  Schema: schemas/site.schema.json

name: {{projectName}}
foundation: foundation

index: report

queries:
  members:
    # Queryable surface — declares which fields a foundation can offer
    # for filtering UI. The FilterPanel component reads this metadata
    # via the useQueryable hook and renders one control per
    # field. Composed predicates flow through the same useFetched path
    # as saved-view selections; the framework evaluates them over the
    # compiled records, and a host that answers queries would evaluate
    # the very same predicate at the source.
    queryable:
      department:
        type: enum
        label: Department
        options: [biology, geology]
      rank:
        type: enum
        label: Rank
        options: [associate, professor]
      tenured:
        type: boolean
        label: Tenured
      start_year:
        type: range
        label: Start year
        min: 1820
        max: 1880
  queries:

# Where the predicate runs. The site's records compile to /data/<name>.json
# and every `where:` — a saved view, a panel-composed filter — is evaluated
# in the browser over that file; two sections with different predicates share
# one cached fetch. Published to a Uniweb host, the same predicate is answered
# live by the host. A backend of your own is reached through a foundation
# TRANSPORT selected here (`fetcher.transports`), never through a site-level
# knob — see docs: development/connecting-a-backend.md.

build:
  prerender: true
